# Normalize line endings in the repository to LF.
# This project is edited on both Windows and Linux; without this, every
# cross-platform checkout rewrites every line of every file and buries real
# diffs in CRLF churn (45 files were in exactly that state).
* text=auto eol=lf

# PowerShell scripts keep CRLF in the working tree.
*.ps1 text eol=crlf

*.pt  binary
*.png binary
*.jpg binary
