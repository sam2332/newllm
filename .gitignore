*.log
*.pyc
__pycache__/
.venv/
# Exclude the CONTENTS, not the directory itself: git cannot re-include a file
# whose parent directory is excluded, so "archive/" would make the negation
# below silently do nothing.
archive/*
!archive/notes/

# Checkpoints are hundreds of MB each; keep them out of git.
checkpoints*/
*.pt
*.resume
*.resume.tmp

data/cache/
logs/

results/

# data/ IS tracked: ollama_pool.json and sandbox_pool.json are small
# (~110KB) and expensive to regenerate, so they are worth versioning.

# An empty clone of this same repo, nested in the working tree. origin is
# already configured here, so it is redundant - kept only so nothing of the
# user's is deleted without asking.
newllm/

# Timestamped copies made before a destructive pool regeneration; the live pool
# is tracked, so these are duplicates.
data/*.backup*.json
