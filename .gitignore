*.log
*.pyc
__pycache__/
.venv/
# Exclude the CONTENTS, not the directory itself: git cannot re-include a file
# whose parent directory is excluded, so "archive/" would make the negation
# below silently do nothing.
archive/*
!archive/notes/

# Checkpoints are hundreds of MB each; keep them out of git.
checkpoints*/
*.pt
*.resume
*.resume.tmp

data/cache/
logs/

results/

# data/ IS tracked: ollama_pool.json and sandbox_pool.json are small
# (~110KB) and expensive to regenerate, so they are worth versioning.

# An empty clone of this same repo, nested in the working tree. origin is
# already configured here, so it is redundant - kept only so nothing of the
# user's is deleted without asking.
newllm/

# Timestamped copies made before a destructive pool regeneration; the live pool
# is tracked, so these are duplicates.
data/*.backup*.json

# Generated artifacts of the tokenizer/export pipeline
data/corpus/
*.gguf

# Teacher work-in-progress; the completed library is committed instead.
data/*.partial.json

# The webhook URL is a credential: anyone with it can post to the channel.
# config.example.json is the committed template.
config.json

# A stray character in the name (config..json) left a live webhook URL
# outside the ignore rule and one "git add -A" from being published.
config*.json
!config.example.json

# Pretraining shards: 18 GB of packed uint16 tokens, rebuildable from
# scripts/build_pretrain_shards.py. A `git add -A` swept these in once and
# turned a push into a timeout.
data/pretrain/
# Imported HF datasets: large, and reproducible from scripts/import_hf_dataset.py
data/hf_*.json
